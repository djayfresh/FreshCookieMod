    { "when": { "facing": "west" }, "apply": { "model": "freshcaa:block/sun_drying_table", "y": 270 } },

    { "when": { "contents": "grapes", "facing": "north" }, "apply": { "model": "freshcaa:block/sun_drying_table_grapes" } },
